  "flavorEvents": [
    { "id": "relic-kowtow", "title": "秘境误会", "detail": "弟子沈玉衡寻得一处秘境，对坐化上师遗骸哐哐磕了三个响头。遗骸旁浮出一行小字：孩子，咱这是修仙世界，不是武侠。" },
    { "id": "furnace-sweet-potato", "title": "丹炉异香", "detail": "丹炉今日霞光大盛，众弟子以为神丹将成。开炉后才发现，是值守弟子把烤红薯忘在了里面。" },
    { "id": "crane-waits", "title": "仙鹤等饭", "detail": "一只仙鹤在练功房外站了一整天。弟子们不敢惊扰，傍晚才发现它只是在等人投喂。", "effect": { "herbs": -1, "reputation": 1 } },
    { "id": "longevity-pill", "title": "延寿之问", "detail": "山下来客问：服下此丹，真能延寿百年？店中弟子答：不能，但您会觉得这钱花得很有希望。", "effect": { "spirit": 30, "reputation": -1 } },
    { "id": "sword-drying-rack", "title": "剑阵新用", "detail": "炼器坊七剑齐鸣，众人如临大敌。查验后发现，是新来的弟子把剑阵当成了晾衣架。" },
    { "id": "mine-dragon", "title": "矿中龙吟", "detail": "灵矿深处传来阵阵龙吟。掌门亲临查看，发现只是两块矿石卡在矿车轮下。", "effect": { "spiritOre": 2 } },
    { "id": "wrong-lecture", "title": "长老讲错书", "detail": "长老讲道三个时辰，弟子们听得如痴如醉。事后才发现长老拿错讲义，讲的是《灵田除虫要诀》。" },
    { "id": "young-cultivator", "title": "年轻散修", "detail": "一位散修在山门外站了半日，终于鼓起勇气询问：贵宗还收三百岁的年轻弟子吗？" },
    { "id": "banner-trial", "title": "万妖幡试用", "detail": "法器铺挂出万妖幡试用体验。当天没有妖怪上门，倒是吓跑了三名来看热闹的客人。" },
    { "id": "great-opportunity", "title": "天降机缘", "detail": "弟子夜观天象，断言明日必有大机缘。次日清晨，他在路边捡到了一枚别人掉落的灵石。", "effect": { "spirit": 1 } },
    { "id": "garden-foundation", "title": "灵草齐颤", "detail": "弟子勤修不辍，子时灵气激荡，引得满园灵草齐齐一颤。众人围观许久，最后一致认为动静很大。" },
    { "id": "furnace-near-miss", "title": "丹炉虚惊", "detail": "炼丹房炉压骤升，值守弟子手忙脚乱。好在长老及时赶到，只炸黑了房梁，没有损失丹药。" },
    { "id": "herb-garden-fire", "title": "药园小火", "detail": "灵药园夜间冒出火光，弟子们连夜扑救。天亮才发现只是驱虫符烧得太旺，所幸无人受伤。" },
    { "id": "closed-door-exit", "title": "闭关出门", "detail": "弟子闭关七日，出关时气息凝实。掌门亲临道贺，对方却问：食堂今日还有饭吗？" },
    { "id": "ore-surge", "title": "矿脉异动", "detail": "灵矿深处矿脉异动，一夜之间涌出大量矿石，矿工来不及搬运，只好先堆在洞口。", "effect": { "spiritOre": 5 } },
    { "id": "cliff-cave", "title": "崖下洞府", "detail": "一位外门弟子采药时失足跌落，却在崖下发现前人洞府。洞里只有半卷模糊丹方和一张欠条。" },
    { "id": "shop-preacher", "title": "店门论道", "detail": "丹药铺来了一位怪客，不买丹药，只坐在门口念叨道法自然。弟子们不敢驱赶，只好给他添了把椅子。" },
    { "id": "flying-swords-roof", "title": "飞剑修屋", "detail": "炼器坊七柄青锋剑齐齐射出房顶。众人连夜修补，顺便抄了三遍《炼器安全守则》。", "effect": { "spirit": -50, "reputation": 2 } },
    { "id": "waterfall-enlightenment", "title": "观瀑顿悟", "detail": "弟子观瀑布三天三夜后豁然开朗。众人上前求教，他只说：瀑布后面真的没有洞府。" },
    { "id": "squirrel-thief", "title": "厢房异响", "detail": "厢房深夜传出异响，弟子提灯查看，发现是一只偷吃灵果的松鼠。追了半个时辰，松鼠仍安然无恙。" }
  ],
